{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissoes da janela principal do Sumi: IPC basico + HTTP nativo (sem CORS) + abrir links + dialogos.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://127.0.0.1:*" }, { "url": "http://localhost:*" }]
    },
    "opener:default",
    "dialog:default",
    {
      "identifier": "fs:default",
      "allow": [{ "path": "$DESKTOP/*" }]
    },
    "updater:default"
  ]
}
