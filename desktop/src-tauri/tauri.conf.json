{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sumi",
  "version": "../../package.json",
  "identifier": "com.sumi.reader",
  "build": {
    "beforeDevCommand": "npm --prefix .. run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix .. run build",
    "frontendDist": "../../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Sumi",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Sumi — leitor local de mangas",
    "longDescription": "Sumi e um leitor local de mangas: MangaDex como fonte nativa, extensoes compativeis com Keiyoushi, biblioteca, historico e backup — agora tambem como app desktop."
  }
}
